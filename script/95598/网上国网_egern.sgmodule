#!name= 网上国网
#!desc= 余量查询 | 支持近期用量、全部户号通知、服务模式
#!author= 𝐎𝐍𝐙𝟑𝐕
#!category= 通用重写
#!channel= https://t.me/onz3v_channel
#!arguments= CRONEXP:"0 9 * * *",USERNAME:"",PASSWORD:"",SGCC:"网上国网",调试模式:false,近期用量:false,通知全部户号:false,TIMEOUT:60

[Script]
{{{SGCC}}}接口重写 = type=http-request, pattern=^https?:\/\/api\.wsgw-rewrite\.com\/electricity\/bill\/all, script-path=https://cdn.jsdelivr.net/gh/Tbagzhy/ios_rule_script@6cd54a2/script/95598/95598_egern.js, requires-body=true, max-size=-1, timeout={{{TIMEOUT}}}

网上国网 = type=cron, cronexp="{{{CRONEXP}}}", script-path=https://cdn.jsdelivr.net/gh/Tbagzhy/ios_rule_script@6cd54a2/script/95598/95598_egern.js, timeout={{{TIMEOUT}}},argument=username="{{{USERNAME}}}"&password="{{{PASSWORD}}}"&debug="{{{调试模式}}}"&show_recent_usage="{{{近期用量}}}"&notify_all_accounts="{{{通知全部户号}}}"

[MITM]
hostname = %APPEND% api.wsgw-rewrite.com,api.120399.xyz,www.95598.cn
